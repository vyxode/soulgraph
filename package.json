{
  "name": "soulgraph",
  "version": "0.1.0",
  "description": "Live 3D map of your project (files + Roblox Studio) for you and for Claude. / Mapa 3D en vivo de tu proyecto para ti y para Claude.",
  "author": "Vyxode",
  "license": "MIT",
  "homepage": "https://github.com/vyxode/soulgraph#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vyxode/soulgraph.git"
  },
  "keywords": [
    "claude",
    "claude-code",
    "roblox",
    "roblox-studio",
    "knowledge-graph",
    "code-map",
    "luau"
  ],
  "bin": {
    "soulgraph": "cli/soulgraph.js"
  },
  "files": [
    "cli",
    "src",
    "public",
    "roblox",
    "skills",
    ".claude-plugin"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
