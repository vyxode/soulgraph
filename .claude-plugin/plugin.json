{
  "name": "soulgraph",
  "version": "0.3.1",
  "description": "Gives Claude a live map of your project (files + Roblox Studio) so it finds things without opening files one by one. Includes a 3D neural-network panel on localhost.",
  "author": {
    "name": "Vyxode",
    "url": "https://github.com/vyxode"
  },
  "homepage": "https://github.com/vyxode/soulgraph",
  "repository": "https://github.com/vyxode/soulgraph",
  "license": "MIT",
  "keywords": [
    "roblox",
    "roblox-studio",
    "knowledge-graph",
    "code-map",
    "luau"
  ],
  "mcpServers": {
    "soulgraph": {
      "command": "node",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/cli/soulgraph.js",
        "mcp",
        "${CLAUDE_PROJECT_DIR}"
      ]
    }
  }
}
